{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "assistant-v2"
    },
    "agent_mode": {
      "const": "pro"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S"
    },
    "product_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spu_id": {
            "type": "integer",
            "minimum": 1
          },
          "sku_id": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string"
          },
          "size_advice": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "enum": [
              "generic_rule",
              "product_chart",
              null
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "spu_id",
          "sku_id",
          "reason"
        ]
      },
      "maxItems": 20
    },
    "requirements": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "enum": [
              "pending",
              "satisfied",
              "needs_input",
              "unconfirmed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "text",
          "status",
          "evidence_ids"
        ]
      }
    },
    "stop_reason": {
      "enum": [
        "completed",
        "needs_input",
        "budget_exhausted",
        "validation_failed",
        "dependency_unavailable",
        "invalid_response",
        "cancelled"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "token_usage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "input_tokens",
                "output_tokens",
                "total_tokens"
              ]
            }
          ]
        }
      },
      "required": [
        "decisions",
        "tool_calls",
        "elapsed_ms",
        "token_usage"
      ]
    }
  },
  "required": [
    "contract_version",
    "agent_mode",
    "request_id",
    "run_id",
    "thread_id",
    "answer",
    "product_refs",
    "requirements",
    "stop_reason",
    "metrics"
  ]
}
